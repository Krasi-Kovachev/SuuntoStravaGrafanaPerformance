Environment variables and secrets can be handled directly in the Azure Container app (Environment variables) - less secure
OR using an Azure Key Vault + Azure Container app Environment variables.


# Keep the app and resource group variables from earlier
RESOURCE_GROUP="grafana-activity-app-rg"
APP_NAME="grafana-app-dashboard"


# This assumes that the datbase is hosted with Neon.

GF_DATABASE_TYPE="postgres"
GF_DATABASE_HOST="ep-soft-credit-XXXXXXeu-west-2.aws.neon.tech" # host address
GF_DATABASE_NAME="grafana" # your database name on Neon
GF_DATABASE_USER="dbUserName" # your database user on Neon
GF_DATABASE_PASSWORD="dbPassword" # your database password on Neon
GF_DATABASE_SSL_MODE="required"


Option 1 - less secure (inject the data directly in the Container environment variables)

az containerapp update \
  --name $APP_NAME \
  --resource-group $RESOURCE_GROUP \
  --set-env-vars \
    GF_DATABASE_TYPE=postgres \
    GF_DATABASE_HOST=ep-soft-credit-XXXXXXeu-west-2.aws.neon.tech \
    GF_DATABASE_NAME=dbName \
    GF_DATABASE_USER=dbUserName \
    GF_DATABASE_PASSWORD=dbPassword \
    GF_DATABASE_SSL_MODE=require


Option 2 - password as secret (using the build in Container App secret store)

az containerapp secret set --name $APP_NAME --resource-group $RESOURCE_GROUP --secrets grafana-db-password="$DB_PASSWORD"

az containerapp update \
  --name $APP_NAME \
  --resource-group $RESOURCE_GROUP \
  --set-env-vars \
    GF_DATABASE_TYPE=postgres \
    GF_DATABASE_HOST=$DB_HOST \
    GF_DATABASE_NAME=$DB_NAME \
    GF_DATABASE_USER=$DB_USER \
    GF_DATABASE_PASSWORD=secretref:grafana-db-password \
    GF_DATABASE_SSL_MODE=require

Option 3 - secure (create a Key Vault, store the data there and reference the Key Vault entries in the Container environment variables)

KV_NAME="grafana-activity-app-XXXX-kv" # Key Vault names must be globally unique

# Create the Key Vault
az keyvault create \
  --name $KV_NAME \
  --resource-group $RESOURCE_GROUP \
  --location $LOCATION \
  --enable-rbac-authorization

# Store the PostgreSQL password in the vault. Repeat the same for all connection details if required
az keyvault secret set \
  --vault-name $KV_NAME \
  --name "grafana-db-password" \
  --value "your_super_secret_password"

  # Enable Managed Identity
az containerapp identity assign --name $APP_NAME --resource-group $RESOURCE_GROU --system-assigned

# Capture the newly created Identity ID into a variable for the next step
PRINCIPAL_ID=$(az containerapp show --name $APP_NAME --resource-group $RESOURCE_GROUP --query identity.principalId -o tsv)

# Get the Key Vault Resource ID
KV_ID=$(az keyvault show --name $KV_NAME --resource-group $RESOURCE_GROUP --query id -o tsv)

# Assign the "Key Vault Secrets User" role to the Container App
az role assignment create --role "Key Vault Secrets User" --assignee $PRINCIPAL_ID --scope $KV_ID

# Get the exact URL of the secret in the Key Vault
SECRET_URI=$(az keyvault secret show --vault-name $KV_NAME --name "grafana-db-password" --query id -o tsv)

# Update the Container App to reference the Key Vault using its Managed Identity
az containerapp secret set \
  --name $APP_NAME \
  --resource-group $RESOURCE_GROUP \
  --secrets grafana-db-password=keyvaultref:${SECRET_URI},identityref:system